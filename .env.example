# NEXUS Browser — Environment Configuration Template
# Copy this file to .env and provide your project keys to enable real cloud sync and authentication.

# Supabase Project URL (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key_here

# Local loopback port for OAuth 2.0 PKCE redirect callback (default: 42427)
NEXUS_AUTH_REDIRECT_PORT=42427

# Set to 1 only in development/testing if you want to bypass cloud credentials with the in-memory mock provider
# NEXUS_USE_MOCK_AUTH=0
