{
  "manifest_version": 3,
  "name": "NEXUS Dark Mode Helper",
  "version": "1.0.0",
  "description": "A minimal developer-focused extension for testing NEXUS extension APIs.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "NEXUS Dark Helper",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
